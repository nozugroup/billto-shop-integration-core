{
    "name": "billto/shop-integration-core",
    "description": "Platform-independent business logic shared by the BillTo e-commerce plugins (WooCommerce, PrestaShop): buyer scenarios, VAT rate mapping, negative lines, VIES, order and mark-paid payloads, refund corrections. PHP 7.2+, no runtime dependencies.",
    "keywords": ["billto", "invoicing", "ksef", "woocommerce", "prestashop", "e-commerce"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/nozugroup/billto-shop-integration-core",
    "require": {
        "php": ">=7.2",
        "ext-json": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "1.0",
        "pestphp/pest": "^2.36",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "BillTo\\Shop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BillTo\\Shop\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "compat": "phpcs -p --standard=PHPCompatibility --runtime-set testVersion 7.2- src",
        "check": ["@compat", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
